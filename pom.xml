<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent and aggregator of every module. All modules share this version and are released together. -->
    <groupId>io.descoped.secrets</groupId>
    <artifactId>secrets-client-project</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Secrets Client Project</name>
    <description>A provider based API for reading and writing secrets off the Java heap, with providers for a local
        properties file, Google Secret Manager and secrets the platform mounts as files.
    </description>
    <url>https://github.com/descoped/secrets-client-project</url>
    <inceptionYear>2020</inceptionYear>

    <modules>
        <module>secrets-client-bom</module>
        <module>secrets-client-api</module>
        <module>secrets-provider-safe-configuration</module>
        <module>secrets-provider-google-secret-manager</module>
        <module>secrets-provider-mounted</module>
        <module>secrets-provider-aws-secrets-manager</module>
        <!-- Test support for the modules above; never published. -->
        <module>secrets-test-support</module>
        <!-- One coverage report over every module, for SonarCloud; never published. -->
        <module>secrets-coverage</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <jacoco.version>0.8.16</jacoco.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Empty unless the coverage profile's JaCoCo agent sets it; surefire's argLine adds to it. -->
        <argLine></argLine>
        <!-- Reproducible builds: every jar entry gets this time, so the same tag builds the same bytes.
             release:prepare sets it to the release time. -->
        <project.build.outputTimestamp>2026-11-26T16:43:00Z</project.build.outputTimestamp>

        <!-- Dependency versions. Kept as properties, not in dependencyManagement, so that importing
             secrets-client-bom (which inherits this POM) manages the secrets modules only. -->
        <service-provider-api.version>3.0.1</service-provider-api.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ove Ranheim</name>
            <email>ove.ranheim@gmail.com</email>
            <url>https://www.linkedin.com/in/overanheim/</url>
        </developer>
    </developers>

    <!-- The modules live in this repository: their url and scm are the project's, not <url>/<artifactId>. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/descoped/secrets-client-project.git</connection>
        <developerConnection>scm:git:git@github.com:descoped/secrets-client-project.git</developerConnection>
        <url>https://github.com/descoped/secrets-client-project/tree/master</url>
        <tag>HEAD</tag>
    </scm>

    <!-- SNAPSHOTs of other Descoped modules, read from maven.descoped.io during development. Releases come from Maven
         Central, Maven's default; a release has no SNAPSHOT dependency (the central profile's enforcer refuses one).
         The id is not descoped-snapshots: that server holds the publishing token, which must never go to this URL.
         The POM has no distributionManagement: CI names the SNAPSHOT target on its command line, so a release
         cannot go there. -->
    <repositories>
        <repository>
            <id>descoped-snapshots-public</id>
            <url>https://maven.descoped.io/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <profiles>
        <!-- Releases to Maven Central through the Central Portal, by central-publishing-maven-plugin. Only releases:
             the enforcer fails a SNAPSHOT version before anything is uploaded. SNAPSHOTs go to maven.descoped.io
             only, from CI's snapshot job.
             Release (Ove approves each one): ./mvnw release:prepare release:perform -P secrets
             (`-P secrets` is no profile of this POM: ~/.mavenrc sees it and decrypts the Portal token for that run)
             Server `central` in ~/.m2/settings.xml holds the Portal user token and, for Maven 3.10, lists
             https://central.sonatype.com in repositoryOrigins. Releases are uploaded with autoPublish=false and
             published by hand in the Portal. -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>only-releases-to-central</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseVersion>
                                            <message>Only releases go to Maven Central; SNAPSHOTs go to maven.descoped.io (published by CI).</message>
                                        </requireReleaseVersion>
                                        <requireReleaseDeps>
                                            <message>A release has no SNAPSHOT dependency.</message>
                                        </requireReleaseDeps>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Signing, required by Central for releases. gpg's default-key signs (see ~/.m2/NOTES.md). -->
        <profile>
            <id>sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- One SonarCloud project for the whole reactor, with one JaCoCo report over every module (secrets-coverage):
             the providers' tests cover the API module's TLS and HTTP code. -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_secrets-client-project</sonar.projectKey>
                <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/secrets-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
                <!-- The OpenSSL binding: every TLS and crypto test runs through it, but its other branches are loading
                     on the other OS (CI is Linux), a missing or old OpenSSL, and native calls that throw, which no
                     single environment reaches. -->
                <sonar.coverage.exclusions>**/io/descoped/secrets/api/internal/OpenSsl.java</sonar.coverage.exclusions>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>5.9.0.7382</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <!-- Guarded secret memory needs native access. @{argLine} keeps what the coverage
                             profile's JaCoCo agent sets. -->
                        <argLine>@{argLine} --enable-native-access=io.descoped.secrets.api</argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all</doclint>
                        <failOnWarnings>true</failOnWarnings>
                    </configuration>
                </plugin>

                <!-- copy-dependencies in src/it/consumer/run.sh -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <!-- source:jar-no-fork, help:evaluate and versions:set, used by CI's snapshot job -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.25.3</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <tagNameFormat>@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>central,sign</releaseProfiles>
                        <goals>deploy</goals>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <!-- Sonatype's central-publishing-maven-plugin does not support Maven 4. -->
                                <requireMavenVersion>
                                    <version>[3.6.3,4)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
